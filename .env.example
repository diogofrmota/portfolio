AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true

# Shared Neon Postgres database for TVSync, Couple Planner, Fithub, and future apps.
# Use the pooled URL for application queries and the direct URL for migrations.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# TVSync media discovery. Keep this server-only; never use a NEXT_PUBLIC_ prefix.
TMDB_API_KEY=
TMDB_API_URL=https://api.themoviedb.org/3
TMDB_WATCH_REGION=PT
